<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="App.Widget.TextView" parent="Widget.MaterialComponents.TextView">
        <item name="fontFamily">@font/comic_sans</item>
        <item name="android:fontFamily">@font/comic_sans</item>
    </style>

    <style name="App.Widget.Button" parent="Widget.Material3.Button">
        <item name="fontFamily">@font/comic_sans</item>
        <item name="android:fontFamily">@font/comic_sans</item>
    </style>

    <style name="Base.Theme.GernikApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:textViewStyle">@style/App.Widget.TextView</item>
        <item name="materialButtonStyle">@style/App.Widget.Button</item>
        <!-- Quitar la barra de estado (batería, hora, etc.) -->
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.GernikApp" parent="Base.Theme.GernikApp" />

    <!-- Estilo para los campos de texto de la kopla -->
    <style name="KoplaEditTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">60dp</item>
        <item name="android:background">@android:color/white</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">5dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Estilo para el texto fijo de la kopla -->
    <style name="KoplaTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Estilo para los ImageView de subida de imágenes -->
    <style name="UploadImageStyle">
        <item name="android:layout_width">100dp</item>
        <item name="android:layout_height">100dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:padding">10dp</item>
    </style>
</resources>