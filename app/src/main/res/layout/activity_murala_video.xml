<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D1ECFF">

    <!-- Header -->
    <include
        android:id="@+id/header_layout"
        layout="@layout/menu_arriba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Contenido Central -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@+id/header_layout"
        app:layout_constraintBottom_toTopOf="@+id/footer_layout">

        <!-- Título -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="25dp"
            app:cardBackgroundColor="#4EBFFF"
            app:cardElevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="IKUSI GERNIKAKO BONBARDAKETAREN BIDEOA"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>

        <!-- Click del Video (Como en Andra Mari) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="25dp"
            app:cardBackgroundColor="#4EBFFF"
            app:cardElevation="4dp">

            <ImageButton
                android:id="@+id/imageButtonVideo"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:src="@android:drawable/ic_media_play"
                android:scaleType="fitCenter"
                android:padding="40dp"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="Reproducir video"
                app:tint="@android:color/white" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Footer -->
    <include
        android:id="@+id/footer_layout"
        layout="@layout/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>