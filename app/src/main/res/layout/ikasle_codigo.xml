<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_general"
    tools:context=".ikasle.IkasleActivity">

    <!-- 1. HEADER (Menú Común) -->
    <include
        android:id="@+id/header_layout"
        layout="@layout/menu_arriba"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintBottom_toTopOf="@+id/footer_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_layout">

        <!-- Texto de Instrucción -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Klasearen kodea sartu:"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#3b82f6"
            android:layout_marginBottom="16dp"/>

        <!-- Campo de entrada para el código -->
        <EditText
            android:id="@+id/editTextClassCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="6 digitu kodea"
            android:inputType="number"
            android:maxLength="6"
            android:gravity="center"
            android:textSize="24sp"
            android:textColor="#3b82f6"
            android:background="@drawable/rounded_border"
            android:padding="12dp"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>

    <!-- 2. FOOTER (Menú Común) -->
    <include
        android:id="@+id/footer_layout"
        layout="@layout/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>