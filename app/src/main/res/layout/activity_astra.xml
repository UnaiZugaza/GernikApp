<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/layoutCarga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conectando con la sala..."
                android:layout_marginTop="10dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPueblo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HERRITARRA (PUEBLO)"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Usa esta pantalla para apuntar tus sospechas y enséñaselo al policía si lo encuentras."
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"/>

            <EditText
                android:id="@+id/etBlocNotas"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="#FFF9C4"
                android:gravity="top|start"
                android:padding="15dp"
                android:hint="Escribe aquí tus sospechas..."
                android:inputType="textMultiLine"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPolicia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POLIZIA (POLICÍA)"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#2196F3"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eres el encargado de atrapar al asesino. Si fallas, serás eliminado."
                android:layout_marginTop="10dp"
                android:layout_marginBottom="30dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nombre del sospechoso">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSospechoso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnAcusar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACUSAR (FINALIZAR JUEGO)"
                android:backgroundTint="#D32F2F"
                android:layout_marginTop="20dp"
                android:padding="15dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAsesino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HILTZAILEA (ASESINO)"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#D32F2F"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤫"
                android:textSize="80sp"
                android:layout_marginTop="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Que no te descubran. Si eliminan a todos los policías, tú ganas."
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:textSize="18sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutMuerto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☠️"
                android:textSize="80sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HAS SIDO ELIMINADO"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#000000"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutFinJuego"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:background="#E0F7FA"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JUEGO TERMINADO"
                android:textSize="22sp"/>

            <TextView
                android:id="@+id/tvGanador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GANADOR: ???"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:textColor="#000000"/>

            <Button
                android:id="@+id/btnSalir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Volver al Menú"
                android:layout_marginTop="30dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>