<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/layoutCarga"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ECEFF1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conectando con el satélite..."
            android:textColor="#455A64" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutEspera"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF9800"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="30dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@android:drawable/ic_menu_my_calendar"
            app:tint="#FFFFFF"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SALA DE ESPERA"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Espera a que el profesor inicie la partida..."
            android:textColor="#FFF3E0"
            android:gravity="center"
            android:textSize="18sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutPueblo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFEB3B"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ERES PUEBLO"
            android:textColor="#F57F17"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Sobrevive y ayuda a encontrar a los asesinos!"
            android:gravity="center"
            android:textColor="#FBC02D"
            android:textSize="18sp"
            android:layout_marginBottom="40dp"/>

        <Button
            android:id="@+id/btnSalir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SALIR"
            android:backgroundTint="#FBC02D"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutPolicia"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2196F3"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="#FFFFFF"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ERES POLICÍA"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Encuentra a los asesinos:"
            android:textColor="#BBDEFB"
            android:textSize="18sp"
            android:layout_marginBottom="20dp"/>

        <Spinner
            android:id="@+id/spinnerSospechosos"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnAcusar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚖️ ACUSAR / INVESTIGAR"
            android:textSize="18sp"
            android:padding="15dp"
            android:backgroundTint="#0D47A1"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutAsesino"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#D32F2F"
        android:visibility="gone"
        android:padding="20dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_delete"
            app:tint="#FFFFFF"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ERES EL ASESINO"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elige una víctima:"
            android:textColor="#FFCDD2"
            android:layout_marginBottom="10dp"/>

        <Spinner
            android:id="@+id/spinnerVictimas"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnMatar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="☠️ MATAR ☠️"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="#212121"
            android:textColor="#FFFFFF"
            android:padding="15dp"/>

        <TextView
            android:id="@+id/tvCooldown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recargando..."
            android:textColor="#FFEB3B"
            android:textSize="16sp"
            android:visibility="invisible"
            android:layout_marginTop="10dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutMuerto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#212121"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#F44336"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HAS SIDO ELIMINADO"
            android:textColor="#F44336"
            android:textSize="28sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutFinJuego"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4CAF50"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvGanador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GANADOR: PUEBLO"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center"/>
    </LinearLayout>

</FrameLayout>