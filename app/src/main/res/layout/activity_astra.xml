<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_general"
    tools:context=".Actividades_Geltokiak.AstraActivity">

    <include
        android:id="@+id/include_header"
        layout="@layout/menu_arriba"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/include_header"
        app:layout_constraintBottom_toTopOf="@+id/include_footer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/layoutCarga"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">
                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:indeterminateTint="#1976D2"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/konektatzen"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutEspera"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#1976D2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/aukeratu_zure_avatarra"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="15dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginBottom="20dp">

                            <ImageView
                                android:id="@+id/ivSelectAvatar1"
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:src="@drawable/kyle"
                                android:background="@drawable/rounded_border"
                                android:padding="2dp"
                                android:layout_marginEnd="10dp"
                                android:alpha="1.0"/> <ImageView
                            android:id="@+id/ivSelectAvatar2"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:src="@drawable/cartman"
                            android:background="@drawable/rounded_border"
                            android:padding="2dp"
                            android:layout_marginEnd="10dp"
                            android:alpha="0.5"/>

                            <ImageView
                                android:id="@+id/ivSelectAvatar3"
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:src="@drawable/kenny"
                                android:background="@drawable/rounded_border"
                                android:padding="2dp"
                                android:alpha="0.5"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvContadorJugadores"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/irakaslearen_zain"
                            android:textColor="#BBDEFB"
                            android:textSize="18sp"
                            android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutPueblo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="#FFF176"
                    app:cardElevation="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/herritarra_zara"
                            android:textColor="#F57F17"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/biziraun_ezazu"
                            android:textColor="#FBC02D"
                            android:textSize="18sp"
                            android:layout_marginBottom="10dp"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvPueblo"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginBottom="15dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/oharrak_susmoak"
                            android:textStyle="bold"
                            android:textColor="#F57F17"
                            android:layout_marginBottom="5dp"
                            android:gravity="start"/>

                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:background="#FFFFFF"
                            android:gravity="top|start"
                            android:hint="@string/idatzi_hemen"
                            android:padding="10dp"
                            android:textSize="14sp"
                            android:inputType="textMultiLine"
                            android:scrollbars="vertical"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutPolicia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="#64B5F6"
                    app:cardElevation="6dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/polizia"
                            android:textColor="#0D47A1"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvPolicia"
                            android:layout_width="match_parent"
                            android:layout_height="250dp"
                            android:layout_marginBottom="10dp"/>
                        <Spinner
                            android:id="@+id/spinnerSospechosos"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@android:drawable/btn_dropdown"
                            android:layout_marginBottom="10dp"/>
                        <Button
                            android:id="@+id/btnAcusar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ikertu_salatu"
                            android:backgroundTint="#0D47A1"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutAsesino"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="#E57373"
                    app:cardElevation="6dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hiltzailea"
                            android:textColor="#B71C1C"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvAsesino"
                            android:layout_width="match_parent"
                            android:layout_height="250dp"
                            android:layout_marginBottom="10dp"/>
                        <Spinner
                            android:id="@+id/spinnerVictimas"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@android:drawable/btn_dropdown"
                            android:layout_marginBottom="10dp"/>
                        <Button
                            android:id="@+id/btnMatar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hil"
                            android:backgroundTint="#212121"
                            android:textColor="#FFFFFF"/>
                        <TextView
                            android:id="@+id/tvCooldown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/kargatzen"
                            android:textColor="#B71C1C"
                            android:visibility="invisible"
                            android:layout_marginTop="5dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutMuerto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="#424242">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="30dp"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:src="@android:drawable/ic_delete"
                            app:tint="#F44336"
                            android:layout_marginBottom="20dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/eliminatua"
                            android:textColor="#F44336"
                            android:textSize="30sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutFinJuego"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardFinJuego"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="30dp"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvGanador"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/irabazlea"
                            android:textColor="#000000"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </FrameLayout>
    </ScrollView>

    <include
        android:id="@+id/include_footer"
        layout="@layout/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>