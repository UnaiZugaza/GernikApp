<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#e0f2fe"
    tools:context=".MainActivity">

    <!-- 1. HEADER (Menú de arriba) -->
    <include
        android:id="@+id/header_layout"
        layout="@layout/menu_arriba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 2. CONTENIDO PRINCIPAL (Centrado) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOR ZARA?"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#3b82f6"
            android:layout_marginBottom="24dp"/>

        <!-- NUEVO: Campo para escribir el nombre -->
        <EditText
            android:id="@+id/editTextNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Idatzi zure izena (Escribe tu nombre)"
            android:inputType="textPersonName"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="12dp"
            android:background="@android:color/white"
            android:layout_marginBottom="32dp" />

        <!-- Botón IRAKASLE -->
        <Button
            android:id="@+id/buttonIrakasle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IRAKASLE"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="#81d4fa"
            android:textColor="#0f172a"
            android:paddingVertical="16dp"
            android:layout_marginBottom="24dp"/>

        <!-- Botón IKASLE -->
        <Button
            android:id="@+id/buttonIkasle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IKASLE"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="#81d4fa"
            android:textColor="#0f172a"
            android:paddingVertical="16dp"/>

    </LinearLayout>

    <!-- 3. FOOTER (Menú de abajo) -->
    <include
        android:id="@+id/footer_layout"
        layout="@layout/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>