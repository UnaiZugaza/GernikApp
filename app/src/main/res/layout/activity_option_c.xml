<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0f9ff"
    tools:context=".OptionMapsActivity">

    <!-- 1. HEADER (Menú Común) - Incluido para mantener la consistencia de la aplicación -->
    <include
        android:id="@+id/header_layout"
        layout="@layout/menu_arriba"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- CONTENIDO PRINCIPAL: Actividades (Jarduerak) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@+id/footer_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_layout">

        <!-- Título de la sección -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jarduerak (Actividades)"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#0369a1"
            android:paddingBottom="16dp"
            android:gravity="center_horizontal"/>

        <!-- Separador visual -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#93c5fd"
            android:layout_marginBottom="24dp"/>

        <!-- Placeholder para la lista de actividades -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Aquí se mostrarán las actividades asignadas por el profesor!"
            android:textSize="18sp"
            android:textColor="#334155"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- RecyclerView o ListView iría aquí para mostrar las tareas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewActivities"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_activity_placeholder"
            />

    </LinearLayout>

    <!-- 2. FOOTER (Menú Común) - Incluido para mantener la consistencia de la aplicación -->
    <include
        android:id="@+id/footer_layout"
        layout="@layout/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>