<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_general"
    tools:context=".Actividades_Geltokiak.AndraMari8Activity">

    <!-- 1. Header -->
    <include
        android:id="@+id/include_header"
        layout="@layout/menu_arriba"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Contenido Central con Scroll -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/include_header"
        app:layout_constraintBottom_toTopOf="@+id/include_footer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <!-- Tarjeta 1: Felicitación -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="25dp"
                app:cardBackgroundColor="#4CAF50"
                app:cardElevation="4dp">

                <TextView
                    android:id="@+id/text_zorionak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:text="@string/zorionak_froga_guztiak_gainditu_dituzu"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </androidx.cardview.widget.CardView>

            <!-- Tarjeta 2: Medalla -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="25dp"
                app:cardBackgroundColor="@color/azul_acento"
                app:cardElevation="4dp">

                <ImageView
                    android:id="@+id/image_domina"
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/domina"
                    android:contentDescription="Domina digitala"/>

            </androidx.cardview.widget.CardView>

            <!-- Botón para ir al Menú Principal -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_to_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_nagusira"
                android:textSize="18sp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@color/azul_acento"
                android:textColor="@android:color/black" />

        </LinearLayout>
    </ScrollView>

    <!-- 3. Footer (Sin botones de navegación) -->
    <include
        android:id="@+id/include_footer"
        layout="@layout/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>