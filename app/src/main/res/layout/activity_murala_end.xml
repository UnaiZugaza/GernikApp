<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_general"
    tools:context=".Actividades_Geltokiak.MuralaEndActivity">

    <!-- HEADER -->
    <include
        android:id="@+id/header_layout"
        layout="@layout/menu_arriba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- CONTENIDO PRINCIPAL -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="24dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btn_volver_menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Caja de texto azul con bordes redondeados -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/azul_acento"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    android:layout_marginTop="32dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="24dp"
                        android:text="@string/aurreko_geldialdietan_bildu_ditugun_puzzleko_piezak_erabiliz_el_guernica_margolana_osatuko_dugu"
                        android:textColor="@android:color/black"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:lineSpacingExtra="4dp" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/textViewAnimo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/prest_zaudete_animo_puzzlearekin_ez_baita_erraza"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#0f172a"
                    android:textAlignment="center"
                    android:layout_marginTop="48dp" />

                <!-- GIF del Árbol -->
                <ImageView
                    android:id="@+id/iv_arbol_gif_murala_end"
                    android:layout_width="200dp"
                    android:layout_height="180dp"
                    android:layout_marginTop="24dp"
                    android:contentDescription="Arbola animated gif"
                    android:scaleType="centerInside" />

            </LinearLayout>
        </ScrollView>

        <!-- Botón para volver al menú -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_volver_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menura_bueltatu"
            android:background="@drawable/rounded_border"
            android:textColor="@color/azul_acento"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- FOOTER -->
    <include
        android:id="@+id/footer_layout"
        layout="@layout/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>