<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#e0f2fe"
    tools:context=".GernikakoMuralaOngiEtorriActivity">

    <!-- HEADER -->
    <include
        android:id="@+id/header_layout"
        layout="@layout/menu_arriba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- CONTENIDO PRINCIPAL -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="32dp">

        <!-- Zona de texto desplazable (Título y Explicación) -->
        <!-- Se ancla arriba y termina justo encima del texto de abajo -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/textViewJarraitu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Título -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ongi etorri Gernikako Muralera!"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#3b82f6"
                    android:textAlignment="center"
                    android:layout_marginBottom="32dp"/>

                <!-- Explicación -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hau Pablo Picassoren 'Guernica' koadro ospetsuaren erreplika bat da. 1937ko apirilaren 26an Gernikak jasandako bonbardaketa irudikatzen du. Gerraren izugarrikeriak eta bakearen nahia erakusten dizkigu mundu osoari."
                    android:textSize="20sp"
                    android:textColor="#0f172a"
                    android:justificationMode="inter_word"
                    android:lineSpacingExtra="8dp"
                    android:layout_marginBottom="16dp"/>
            </LinearLayout>
        </ScrollView>

        <!-- Texto final (Anclado abajo del todo) -->
        <TextView
            android:id="@+id/textViewJarraitu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jarraitu bideoa ikusteko"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#059669"
            android:textAlignment="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- FOOTER -->
    <include
        android:id="@+id/footer_layout"
        layout="@layout/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>