<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_general"
    tools:context=".Actividades_Geltokiak.GernikakoMuralaOngiEtorriActivity">

    <include
        android:id="@+id/header_layout"
        layout="@layout/menu_arriba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="32dp">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/iv_arbol_gif"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ongi_etorri_gernikako_muralera"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-casual"
                    android:textColor="#3b82f6"
                    android:textAlignment="center"
                    android:layout_marginBottom="32dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hau_pablo_picassoren_guernica_koadro_ospetsuaren_erreplika_bat_da_1937ko_apirilaren_26an_gernikak_jasandako_bonbardaketa_irudikatzen_du_gerraren_izugarrikeriak_eta_bakearen_nahia_erakusten_dizkigu_mundu_osoari"
                    android:textSize="20sp"
                    android:textColor="#0f172a"
                    android:justificationMode="inter_word"
                    android:lineSpacingExtra="8dp"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="sans-serif-casual"/>
            </LinearLayout>
        </ScrollView>

        <ImageView
            android:id="@+id/iv_arbol_gif"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginBottom="12dp"
            android:scaleType="fitCenter"
            android:contentDescription="Arbola animated gif"
            app:layout_constraintBottom_toTopOf="@+id/textViewJarraitu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/textViewJarraitu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/jarraitu_bideoa_ikusteko"
            android:textSize="22sp"
            android:fontFamily="sans-serif-casual"
            android:textColor="#059669"
            android:textAlignment="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/footer_layout"
        layout="@layout/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>