<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="100dp">

    <View
        android:id="@+id/background_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#e0f2fe"
        app:layout_constraintBottom_toTopOf="@+id/bar_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/bar_blue"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:background="#3b82f6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/buttonBack"
        android:layout_width="120dp"
        android:layout_height="80dp"
        android:background="@android:color/transparent"
        android:contentDescription="Atzera"
        android:scaleType="fitCenter"
        android:src="@drawable/flechaatzera"
        app:layout_constraintBottom_toTopOf="@+id/bar_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageViewLogo"
        android:layout_width="100dp"
        android:layout_height="90dp"
        android:contentDescription="Logo GernikApp"
        android:scaleType="fitCenter"
        android:src="@drawable/logogernikapp"
        app:layout_constraintBottom_toTopOf="@+id/bar_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/buttonContinue"
        android:layout_width="120dp"
        android:layout_height="80dp"
        android:background="@android:color/transparent"
        android:contentDescription="Jarraitu"
        android:scaleType="fitCenter"
        android:src="@drawable/flechajarraitu"
        app:layout_constraintBottom_toTopOf="@+id/bar_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>