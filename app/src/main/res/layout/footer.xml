<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="120dp">


    <!-- 1. Fondo superior (Azul claro) donde van las imágenes -->
    <View
        android:id="@+id/background_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#E1F5FE"
        app:layout_constraintBottom_toTopOf="@+id/bar_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- 2. Barra inferior (Azul más oscuro) -->
    <View
        android:id="@+id/bar_blue"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:background="#0288D1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <!-- 4. LOGO CENTRAL (Siempre visible) -->
    <ImageButton
        android:id="@+id/buttonBack"
        android:layout_width="150dp"
        android:layout_height="100dp"
        android:background="@android:color/transparent"
        android:contentDescription="Atzera"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/flechaatzera"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/bar_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/background_top"
        app:layout_constraintVertical_bias="0.607"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/imageViewLogo"
        android:layout_width="122dp"
        android:layout_height="117dp"
        android:contentDescription="Logo GernikApp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/logogernikapp"
        app:layout_constraintBottom_toTopOf="@+id/bar_blue"
        app:layout_constraintEnd_toStartOf="@+id/buttonContinue"
        app:layout_constraintStart_toEndOf="@+id/buttonBack"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageButton
        android:id="@+id/buttonContinue"
        android:layout_width="150dp"
        android:layout_height="100dp"
        android:background="@android:color/transparent"
        android:contentDescription="Jarraitu"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/flechajarraitu"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/bar_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/background_top" />


</androidx.constraintlayout.widget.ConstraintLayout>
