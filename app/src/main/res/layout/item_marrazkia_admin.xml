<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="15dp"
    app:cardElevation="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvNombreAlumno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ikaslearen_izena"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#38A5E0"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <ImageView
            android:id="@+id/ivDibujoAlumno"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:scaleType="centerCrop"
            android:background="#EEEEEE"
            android:src="@android:drawable/ic_menu_gallery"/>

        <!-- Elementos para puntuar -->
        <LinearLayout
            android:id="@+id/puntuazioa_layout" 
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etPuntuacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Nota (0-10)"
                android:inputType="number"
                android:maxLength="2"/>

            <Button
                android:id="@+id/btnGuardarNota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gorde"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>