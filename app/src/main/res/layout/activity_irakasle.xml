<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D1ECFF"
    tools:context=".irakasle.IrakasleActivity">

    <include
        android:id="@+id/include_header"
        layout="@layout/menu_arriba"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/include_header"
        app:layout_constraintBottom_toTopOf="@+id/include_footer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GELA KODEA (CÓDIGO SALA)"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#3b82f6"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:id="@+id/tvCodigoGenerado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="---"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="20dp"/>

                    <Button
                        android:id="@+id/btnGenerarCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SORTU KODE BERRIA (GENERAR)"
                        android:backgroundTint="#3b82f6"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUKERATU KUDEATZEKO JARDUERA"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#37474F"
                android:layout_marginBottom="15dp"/>

            <Button
                android:id="@+id/btnAdminAstra"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="KUDEATU ASTRA (ASTRA KUDEATU)"
                android:backgroundTint="#D32F2F"
                android:textSize="16sp"
                android:layout_marginBottom="15dp"
                android:enabled="false"/> <Button
            android:id="@+id/btnAdminArbola"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="KUDEATU ARBOLA (ARBOLA KUDEATU)"
            android:backgroundTint="#388E3C"
            android:textSize="16sp"
            android:layout_marginBottom="15dp"
            android:enabled="false"/>

            <Button
                android:id="@+id/btnAdminAndraMari"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="KUDEATU ANDRA MARI"
                android:backgroundTint="#1976D2"
                android:textSize="16sp"
                android:enabled="false"/>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/include_footer"
        layout="@layout/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>