<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#e0f2fe"
    tools:context=".OptionPuzzleActivity">

    <!-- 1. HEADER (Menú Común) -->
    <include
        android:id="@+id/header_layout"
        layout="@layout/menu_arriba"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. BANDA DE PIEZAS (ABAJO) -->
    <HorizontalScrollView
        android:id="@+id/pieces_container_scrollview"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="#81d4fa"
        app:layout_constraintBottom_toBottomOf="parent" 
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/pieces_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"/>
    </HorizontalScrollView>

    <!-- 3. TABLERO DEL PUZZLE (CENTRO) -->
    <FrameLayout
        android:id="@+id/puzzle_board_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toTopOf="@id/pieces_container_scrollview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <GridLayout
            android:id="@+id/puzzle_board"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="6"
            android:rowCount="5">

            <!-- Las 30 celdas se añadirán aquí dinámicamente desde el código -->

        </GridLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
