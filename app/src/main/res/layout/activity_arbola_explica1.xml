<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_general">

    <include
        android:id="@+id/include_header"
        layout="@layout/menu_arriba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollViewTextExplica"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/include_header"
        app:layout_constraintBottom_toTopOf="@+id/iv_arbol_gif_explica1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/duela_urte_asko_1937an_gernika_herria_bonbardatu_egin_zuten_gerra_batean_etxe_asko_suntsitu_ziren_baina_gernikako_arbola_bizirik_geratu_zen_eta_horren_itxaropena_eta_indarra_adierazten_ditu_gaur_egun_ere"
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:fontFamily="sans-serif-casual"
                android:gravity="center"
                android:layout_marginBottom="32dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/orain_zuen_txanda_da_begiratu_arbola_eta_ingurua_arretaz_zer_ikusten_duzue_zer_kolore_daude_zer_sentitzen_duzue_leku_honetan"
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:fontFamily="sans-serif-casual"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>

    <ImageView
        android:id="@+id/iv_arbol_gif_explica1"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:scaleType="fitCenter"
        android:contentDescription="Arbola animated gif"
        app:layout_constraintBottom_toTopOf="@+id/include_footer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/include_footer"
        layout="@layout/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>