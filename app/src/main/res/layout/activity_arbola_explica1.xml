<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_general">

    <include
        android:id="@+id/include_header"
        layout="@layout/menu_arriba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/include_header"
        app:layout_constraintBottom_toTopOf="@+id/include_footer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Duela urte asko, 1937an, Gernika herria bonbardatu egin zuten gerra batean. Etxe asko suntsitu ziren, baina Gernikako Arbola bizirik geratu zen, eta horren itxaropena eta indarra adierazten ditu gaur egun ere."
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:gravity="center"
                android:layout_marginBottom="32dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Orain zuen txanda da: begiratu arbola eta ingurua arretaz - zer ikusten duzue? zer kolore daude? zer sentitzen duzue leku honetan?"
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/include_footer"
        layout="@layout/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>