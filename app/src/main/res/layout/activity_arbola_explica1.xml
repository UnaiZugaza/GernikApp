<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_general">

    <!-- Header -->
    <include
        android:id="@+id/include_header"
        layout="@layout/menu_arriba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ScrollView solo para el texto -->
    <ScrollView
        android:id="@+id/scrollViewTextExplica"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/include_header"
        app:layout_constraintBottom_toTopOf="@+id/iv_arbol_gif_explica1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Duela urte asko, 1937an, Gernika herria bonbardatu egin zuten gerra batean. Etxe asko suntsitu ziren, baina Gernikako Arbola bizirik geratu zen, eta horren itxaropena eta indarra adierazten ditu gaur egun ere."
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:gravity="center"
                android:layout_marginBottom="32dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Orain zuen txanda da: begiratu arbola eta ingurua arretaz - zer ikusten duzue? zer kolore daude? zer sentitzen duzue leku honetan?"
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>

    <!-- GIF del Árbol (FUERA DEL SCROLL, FIJO ABAJO) -->
    <ImageView
        android:id="@+id/iv_arbol_gif_explica1"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginBottom="8dp"
        android:scaleType="centerInside"
        android:contentDescription="Arbola animated gif"
        app:layout_constraintBottom_toTopOf="@+id/include_footer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Footer -->
    <include
        android:id="@+id/include_footer"
        layout="@layout/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>