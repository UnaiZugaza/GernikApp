<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#e0f2fe"
    tools:context=".IrakasleActivity">

    <!-- 1. HEADER (Menú Común) -->
    <include
        android:id="@+id/header_layout"
        layout="@layout/menu_arriba"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintBottom_toTopOf="@+id/footer_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_layout">

        <!-- Texto de Instrucción -->
        <TextView
            android:id="@+id/textViewInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Klasearen kodea:"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#3b82f6"
            android:layout_marginBottom="32dp"/>

        <!-- Código generado (Inicialmente invisible) -->
        <TextView
            android:id="@+id/textViewGeneratedCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="------"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="#3b82f6"
            android:visibility="invisible"
            android:layout_marginBottom="32dp"/>

        <!-- Botón para generar código (Inicialmente visible) -->
        <Button
            android:id="@+id/buttonGenerateCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generar Código"
            android:backgroundTint="#81d4fa"
            android:textColor="#3b82f6"
            android:textSize="18sp"/>

    </LinearLayout>

    <!-- 2. FOOTER (Menú Común) -->
    <include
        android:id="@+id/footer_layout"
        layout="@layout/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>