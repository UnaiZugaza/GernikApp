<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_general">

    <!-- Header -->
    <include
        android:id="@+id/include_header"
        layout="@layout/menu_arriba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/include_header"
        app:layout_constraintBottom_toTopOf="@+id/include_footer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kaixo, lagunak!!!\nOngi etorri Gernikako Arbolara!"
                android:textColor="@android:color/black"
                android:textSize="30sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="32dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Arbola hau oso garrantzitsua da gure herriarentzat. Antzina, euskal herrietako ordezkariak hemen biltzen ziren erabaki garrantzitsuak hartzeko eta herriaren izenean zin egiteko.\nHorregatik, askatasunaren, bakearen eta batasunaren ikurra bihurtu da."
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Footer -->
    <include
        android:id="@+id/include_footer"
        layout="@layout/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>